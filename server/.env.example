PORT=5000
NODE_ENV=development
# Local persistent MongoDB (recommended for dev — started automatically by npm run dev)
# MONGODB_URI=mongodb://127.0.0.1:27017/learnhub
# MongoDB Atlas connection string (production)
# Example: mongodb+srv://learnhub_user:your_password@cluster0.xxxxx.mongodb.net/learnhub?retryWrites=true&w=majority&appName=LearnHub
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/learnhub?retryWrites=true&w=majority&appName=LearnHub
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

