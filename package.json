{
  "name": "learnhub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "mongo": "node scripts/start-mongo.js",
    "predev": "node scripts/kill-dev-ports.js && node scripts/ensure-mongo.js",
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev:client\"",
    "dev:kill-ports": "node scripts/kill-dev-ports.js",
    "dev:client": "wait-on http://127.0.0.1:5000/api/health -t 60000 && npm run dev:vite -w client",
    "dev:server": "npm run dev -w server",
    "seed": "npm run seed -w server",
    "seed:admin": "npm run seed:admin -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.5"
  }
}
